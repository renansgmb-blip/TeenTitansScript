local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local function quemTemCoroa()
    local characters = workspace:FindFirstChild("Characters")
    if not characters then return nil end
    for _, char in ipairs(characters:GetChildren()) do
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and root:FindFirstChild("Crown") then
            return char
        end
    end
    return nil
end

local function pegarCoroa()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local coroaChar = quemTemCoroa()
    if not coroaChar then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "👑 Coroa",
            Text = "Ninguém está com a coroa agora!",
            Duration = 3,
        })
        return
    end

    local coroaRoot = coroaChar:FindFirstChild("HumanoidRootPart")
    if not coroaRoot then return end

    local posicaoOriginal = myRoot.CFrame
    local inicio = tick()
    while tick() - inicio < 1 do
        if not coroaRoot or not coroaRoot.Parent then break end
        myRoot.CFrame = coroaRoot.CFrame * CFrame.new(0, 0, 1)
        task.wait(0.03)
    end
    myRoot.CFrame = posicaoOriginal
end

local function pegarCoroaSeguro()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local hum = myChar:FindFirstChildOfClass("Humanoid")

    local coroaChar = quemTemCoroa()
    if not coroaChar then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "👑 Coroa",
            Text = "Ninguém está com a coroa agora!",
            Duration = 3,
        })
        return
    end

    local coroaRoot = coroaChar:FindFirstChild("HumanoidRootPart")
    if not coroaRoot then return end

    local inicio = tick()
    while tick() - inicio < 1 do
        if not coroaRoot or not coroaRoot.Parent then break end
        myRoot.CFrame = coroaRoot.CFrame * CFrame.new(0, 0, 1)
        task.wait(0.03)
    end

    if hum then hum.PlatformStand = true end
    local destino = CFrame.new(Vector3.new(5.00, 946.00, 386.00))
    local inicio2 = tick()
    while tick() - inicio2 < 0.5 do
        myRoot.CFrame = destino
        task.wait()
    end

    for _, part in ipairs(myChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
        end
    end

    if hum then hum.PlatformStand = false end

    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "✅ Local Seguro!",
        Text = "Você está ancorado no céu!",
        Duration = 5,
    })
end

-- =====================================================
-- ESP DA COROA
-- =====================================================
local espAtivo = false
local espBillboard = nil
local espConexao = nil

local function criarESP(char)
    if espBillboard then espBillboard:Destroy() end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "CoroaESP"
    bb.Size = UDim2.new(0, 120, 0, 50)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = root

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0.6, 0)
    label.BackgroundTransparency = 1
    label.Text = "👑 COROA"
    label.TextColor3 = Color3.fromRGB(255, 220, 0)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.Parent = bb

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0.4, 0)
    distLabel.Position = UDim2.new(0, 0, 0.6, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = ""
    distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distLabel.TextSize = 11
    distLabel.Font = Enum.Font.Gotham
    distLabel.Parent = bb

    -- Atualiza distância
    espConexao = RunService.RenderStepped:Connect(function()
        local myChar = LocalPlayer.Character
        if not myChar or not root or not root.Parent then
            if espConexao then espConexao:Disconnect() end
            return
        end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local dist = math.floor((root.Position - myRoot.Position).Magnitude)
            distLabel.Text = char.Name .. " | " .. dist .. " studs"
        end
    end)

    espBillboard = bb
end

local function removerESP()
    if espBillboard then espBillboard:Destroy() espBillboard = nil end
    if espConexao then espConexao:Disconnect() espConexao = nil end
end

local function atualizarESP()
    if not espAtivo then removerESP() return end
    local coroaChar = quemTemCoroa()
    if coroaChar then
        criarESP(coroaChar)
    else
        removerESP()
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "Crown" and espAtivo then
        task.wait(0.1)
        atualizarESP()
    end
end)
workspace.DescendantRemoving:Connect(function(obj)
    if obj.Name == "Crown" then
        removerESP()
    end
end)

