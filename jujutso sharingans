local function TC(c) table.insert(AllConns, c); return c end

local function GetRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHP(player)
    local c = player.Character; if not c then return 0, 100 end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return 0, 100 end
    return h.Health, h.MaxHealth
end

local function EspCol(player)
    local hp, mx = GetHP(player)
    if mx > 0 and hp / mx < 0.35 then return Color3.fromRGB(255, 140, 0) end
    return Color3.fromRGB(255, 40, 40)
end

-- ═══════════════════════════════
--  ESP
-- ═══════════════════════════════
local function CreateESP(player)
    local obj = { boxes = {}, conns = {} }

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 140, 0, 58); bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true; bb.ResetOnSpawn = false; bb.MaxDistance = Config.MaxDist

    local nameLbl = Instance.new("TextLabel", bb)
    nameLbl.Size = UDim2.new(1, 0, 0.44, 0); nameLbl.BackgroundTransparency = 1
    nameLbl.TextColor3 = Color3.fromRGB(255, 40, 40); nameLbl.TextStrokeTransparency = 0.3
    nameLbl.TextStrokeColor3 = Color3.new(0, 0, 0); nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 13; nameLbl.Text = player.Name

    local infoLbl = Instance.new("TextLabel", bb)
    infoLbl.Size = UDim2.new(1, 0, 0.38, 0); infoLbl.Position = UDim2.new(0, 0, 0.48, 0)
    infoLbl.BackgroundTransparency = 1; infoLbl.TextColor3 = Color3.fromRGB(255, 40, 40)
    infoLbl.TextStrokeTransparency = 0.3; infoLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    infoLbl.Font = Enum.Font.Gotham; infoLbl.TextSize = 11; infoLbl.Text = ""

    obj.bb = bb; obj.nameLbl = nameLbl; obj.infoLbl = infoLbl

    local function Attach()
        for _, b in ipairs(obj.boxes) do pcall(function() b:Destroy() end) end
        obj.boxes = {}
        local char = player.Character; if not char then return end
        for _, pn in ipairs(Config.BodyParts) do
            local part = char:FindFirstChild(pn)
            if part and part:IsA("BasePart") then
                local box = Instance.new("SelectionBox")
                box.Adornee = part; box.Color3 = Color3.fromRGB(255, 40, 40)
                box.LineThickness = 0.03; box.SurfaceTransparency = 0.85
                box.SurfaceColor3 = Color3.fromRGB(255, 40, 40); box.Parent = workspace
                table.insert(obj.boxes, box)
            end
        end
        local head = char:FindFirstChild("Head") or char:FindFirstChildOfClass("BasePart")
        if head then bb.Adornee = head; bb.Parent = char end
    end

    Attach()
    table.insert(obj.conns, TC(player.CharacterAdded:Connect(function()
        task.wait(0.2); Attach()
    end)))
    table.insert(obj.conns, TC(RunService.Heartbeat:Connect(function()
        if Destroyed or not Config.EspEnabled then return end
        local char = player.Character; if not char then return end
        local head = char:FindFirstChild("Head") or char:FindFirstChildOfClass("BasePart")
        local root = char:FindFirstChild("HumanoidRootPart")
        local mr   = GetRoot()
        if not head or not root or not mr then return end
        local dist = math.floor((root.Position - mr.Position).Magnitude)
        if dist > Config.MaxDist then
            bb.Parent = nil
            for _, b in ipairs(obj.boxes) do b.Visible = false end
            return
        end
        if bb.Parent ~= char then bb.Adornee = head; bb.Parent = char end
        local col = EspCol(player)
        nameLbl.TextColor3 = col
        local hp, mx = GetHP(player)
        infoLbl.Text = string.format("♥ %d%%   📍 %dm",
            mx > 0 and math.floor(hp / mx * 100) or 0, dist)
        infoLbl.TextColor3 = col
        for _, box in ipairs(obj.boxes) do
            if box and box.Parent then box.Color3 = col; box.SurfaceColor3 = col end
        end
    end)))
    return obj
end

local function RemoveESP(player)
    local obj = EspObjects[player]; if not obj then return end
    if obj.bb then pcall(function() obj.bb:Destroy() end) end
    for _, b in ipairs(obj.boxes or {}) do pcall(function() b:Destroy() end) end
    for _, c in ipairs(obj.conns or {}) do pcall(function() c:Disconnect() end) end
    EspObjects[player] = nil
end

local function ClearESP()
    for p, _ in pairs(EspObjects) do RemoveESP(p) end; EspObjects = {}
end

local function EnableESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then EspObjects[p] = CreateESP(p) end
    end
    TC(Players.PlayerAdded:Connect(function(p)
        if Config.EspEnabled and not Destroyed then EspObjects[p] = CreateESP(p) end
    end))
    TC(Players.PlayerRemoving:Connect(function(p) RemoveESP(p) end))
end

-- ═══════════════════════════════
--  NOCLIP CORRIGIDO
--  Usa LoopedPhysics: desativa colisão a cada Stepped
--  sem teleportar de volta (sem mexer em CFrame ou velocidade)
-- ═══════════════════════════════
local noclipConn = nil

local function StartNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end)
end

local function StopNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    -- Restaura colisão
    local char = LocalPlayer.Character
    if char then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                -- Humanoid controla CanCollide; forçar true causa loop
                -- então deixamos o engine resetar sozinho ao respawnar
                -- Apenas restaura a HumanoidRootPart
                if v.Name == "HumanoidRootPart" then
                    v.CanCollide = false -- HRP nunca tem colisão mesmo
                end
            end
        end
    end
end

-- Garante que o noclip continua após respawn do personagem
TC(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if Config.NoclipEnabled then StartNoclip() end
end))

-- ═══════════════════════════════
--  HITBOX
-- ═══════════════════════════════
TC(RunService.RenderStepped:Connect(function()
    if Destroyed or not Config.HitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        pcall(function()
            local c  = p.Character; if not c then return end
            local rp = c:FindFirstChild("HumanoidRootPart"); if not rp then return end
            rp.Size         = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
            rp.Transparency = 0.6
            rp.BrickColor   = BrickColor.new("Really blue")
            rp.Material     = Enum.Material.Neon
            rp.CanCollide   = false
        end)
    end
end))

local function StopHitbox()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        pcall(function()
            local c  = p.Character; if not c then return end
            local rp = c:FindFirstChild("HumanoidRootPart"); if not rp then return end
            rp.Size        = Vector3.new(2, 2, 1); rp.Transparency = 1
            rp.Material    = Enum.Material.SmoothPlastic; rp.CanCollide = false
        end)
    end
end

-- ═══════════════════════════════
--  ANTI-LAG
--  Remove efeitos visuais pesados do mapa
-- ═══════════════════════════════
local antiLagBackup = {}

local function ApplyAntiLag()
    -- Qualidade de renderização
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01

    -- Desativa efeitos no Lighting
    for _, fx in ipairs(Lighting:GetChildren()) do
        if fx:IsA("PostEffect") or fx:IsA("Atmosphere") or fx:IsA("Sky") then
            antiLagBackup[fx] = fx.Parent
            fx.Parent = nil
        end
    end

    -- Remove partículas e sons do workspace
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
            pcall(function() v.Enabled = false end)
        end
        if v:IsA("Sound") then
            pcall(function() v.Volume = 0 end)
        end
    end

    -- Reduz sombras
    Lighting.GlobalShadows     = false
    Lighting.FogEnd            = 100000
    Lighting.FogStart          = 100000
end

local function RemoveAntiLag()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic

    -- Restaura efeitos de Lighting
    for fx, parent in pairs(antiLagBackup) do
        pcall(function() fx.Parent = parent end)
    end
    antiLagBackup = {}

    -- Reativa partículas
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
            pcall(function() v.Enabled = true end)
        end
        if v:IsA("Sound") then
            pcall(function() v.Volume = 0.5 end)
        end
    end

    Lighting.GlobalShadows = true
end

-- ═══════════════════════════════
--  CLEANUP
-- ═══════════════════════════════
local function Cleanup()
    Destroyed = true
    Config.EspEnabled     = false
    Config.NoclipEnabled  = false
    Config.HitboxEnabled  = false
    Config.AntiLagEnabled = false
    ClearESP(); StopHitbox(); StopNoclip(); RemoveAntiLag()
    for _, c in ipairs(AllConns) do pcall(function() c:Disconnect() end) end
    AllConns = {}
end

